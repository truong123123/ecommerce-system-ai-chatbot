# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Sao chép file này thành .env để chạy docker-compose hoặc môi trường production.
# TUYỆT ĐỐI KHÔNG commit file .env thật vào Git.
# ==============================================================================

# 1. POSTGRESQL DATABASE
POSTGRES_DB=store_dev
POSTGRES_USER=postgres
# Mật khẩu PostgreSQL (Tối thiểu 12 ký tự ngẫu nhiên)
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-16>

# Cấu hình JDBC cho Spring Boot (nếu chạy độc lập ngoài compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/store_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<your-database-password>

# 2. REDIS CACHE & RATE LIMITING
# Mật khẩu Redis bảo vệ bộ đệm và rate limiter
REDIS_PASSWORD=<generate-with-openssl-rand-hex-16>
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=<your-redis-password>

# 3. JWT AUTHENTICATION
# BẮT BUỘC: Chuỗi bí mật tối thiểu 32 byte (256-bit) để ký HMAC-SHA256
# Tạo bằng lệnh: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_EXPIRATION=86400000

# 4. VNPAY PAYMENT GATEWAY
# Thông tin cổng thanh toán sandbox/production từ VNPay
VNPAY_TMN_CODE=<your-vnpay-terminal-code>
VNPAY_HASH_SECRET=<your-vnpay-hash-secret-512bit>
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# 5. FRONTEND (NEXT.JS)
# Địa chỉ API của Backend (Bake vào client bundle lúc build)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
BACKEND_INTERNAL_URL=http://backend:8080/api/v1

# 6. PGADMIN (Tùy chọn cho profile tools)
PGADMIN_DEFAULT_EMAIL=admin@store.local
PGADMIN_DEFAULT_PASSWORD=<generate-strong-pgadmin-password>

# 7. LLM AI CHATBOT (GOOGLE GEMINI / OPENAI)
# Nhà cung cấp LLM: gemini (mặc định)
LLM_PROVIDER=gemini
# Khóa API Google Gemini từ Google AI Studio (bỏ trống nếu muốn chạy ở chế độ fallback)
LLM_API_KEY=<your-google-gemini-api-key>
# Tên mô hình AI (ví dụ: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
LLM_MODEL=gemini-1.5-flash

