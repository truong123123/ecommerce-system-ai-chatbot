# API Endpoint của Backend Spring Boot
# Production: Phải là domain HTTPS thật (VD: https://api.yourdomain.com/api/v1)
# Development: http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Chỉ sử dụng khi chạy lệnh 'npm run build' ở máy cục bộ trỏ tới localhost.
# Mặc định ở production nếu trỏ tới localhost sẽ bị chặn để bảo mật.
ALLOW_LOCAL_API=true

# Khóa bí mật dùng để xác thực xóa cache On-demand Revalidation (/api/revalidate-showcase)
REVALIDATE_SECRET=your_super_secret_revalidate_key_here
